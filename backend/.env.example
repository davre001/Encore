MINDS_BUILDER_API_KEY=
MINDS_ID=
# Optional — defaults to Minds Cloud (https://mdb.ai); set for a custom server
MINDS_BASE_URL=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
UPLOAD_DIR=../uploads
DATA_DIR=../data

# PostgreSQL Database URL (e.g. postgresql://user:password@localhost:5432/encore or Supabase/Neon URL)
DATABASE_URL=

# Server bind for `python -m app` (the uvicorn CLI's --port overrides these)
HOST=127.0.0.1
PORT=5000
