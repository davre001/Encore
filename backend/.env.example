# Minds by Animoca Brands — Builder API key (a JWT) from build.hellominds.ai.
# Set this and the notebook chat stops using the deterministic fallback.
MINDS_BUILDER_API_KEY=
# Optional — pin one Mind. Empty picks the account's first enabled Mind.
MINDS_ID=
# Optional — defaults to https://api.build.hellominds.ai
MINDS_BASE_URL=
# Optional — conversation alias Encore talks through, and how many seconds to
# wait for a Mind's (asynchronous) reply before falling back.
MINDS_ALIAS=encore-notebook
MINDS_REPLY_TIMEOUT=120
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
UPLOAD_DIR=../uploads
DATA_DIR=../data

# PostgreSQL Database URL (e.g. postgresql://user:password@localhost:5432/encore or Supabase/Neon URL)
DATABASE_URL=

# Server bind for `python -m app` (the uvicorn CLI's --port overrides these)
HOST=127.0.0.1
PORT=5000


# Password reset email delivery. Prefer Resend API in production.
RESEND_API_KEY=
# Example: Encore <onboarding@resend.dev> for testing, or a verified domain sender.
# EMAILS_FROM is shared by Resend and SMTP.

# SMTP fallback. Use your SMTP provider values only if not using Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=
# Local/dev only: true prints reset codes to server logs instead of sending email.
EMAIL_DEBUG_LOG_CODES=false
